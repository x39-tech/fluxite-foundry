{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluxite Foundry",
  "version": "../package.json",
  "identifier": "dev.fluxite.foundry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fluxite Foundry",
        "width": 1280,
        "height": 1024,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 15,
          "y": 27
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://foundry.fluxite.dev/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMjI2M0YzNDBGMUNBRDQKUldUVXl2RkE4Mk1pOFdYd3A0M3RveFRLdFBLamFoTWRNZ1cyczBhZGRXK0VYbmd5a09lbkNWSUMK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
