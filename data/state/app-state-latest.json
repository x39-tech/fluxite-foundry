        },
        "chunkEnd": {
          "type": "number"
        },
        "chunkStart": {
          "type": "number"
        },
        "conditions": {
          "items": {
            "$ref": "#/definitions/Condition"
          },
          "type": "array"
        },
        "match": {
          "$ref": "#/definitions/ConditionMatch"
        }
      },
      "type": "object"
    },
    "ConditionMatch": {
      "enum": ["any", "all"],
      "type": "string"
    },
    "DataType": {
      "enum": ["number", "enum", "string", "binary", "boolean", "uuid"],
      "type": "string"
    },
    "DefinitionLocalization": {
      "additionalProperties": false,
      "properties": {
