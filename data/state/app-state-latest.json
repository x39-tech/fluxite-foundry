    },
    "EditorType": {
      "const": "deviceClass",
      "type": "string"
    },
    "EnumChoice": {
      "additionalProperties": false,
      "properties": {
        "@name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": ["id", "@name"],
      "type": "object"
    },
    "EnumInstanceChoices": {
      "additionalProperties": false,
      "properties": {
        "additional": {
          "items": {
            "$ref": "#/definitions/EnumChoice"
          },
          "type": "array"
        },
        "excluded": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
