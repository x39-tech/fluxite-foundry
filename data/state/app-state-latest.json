        },
        "deviceClassId": {
          "type": "string"
        },
        "deviceClassVersion": {
          "type": "string"
        },
        "deviceLibrary": {
          "$ref": "#/definitions/DeviceLibrary"
        },
        "dmx": {
          "$ref": "#/definitions/DmxSerializerState"
        },
        "libraries": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "localizations": {
          "additionalProperties": {
            "$ref": "#/definitions/DefinitionLocalization"
          },
          "type": "object"
        },
        "orgId": {
          "$ref": "#/definitions/OrgId"
        },
        "parameters": {
          "$ref": "#/definitions/ParametersEditorState"
        },
        "resources": {
          "$ref": "#/definitions/ResourcesEditorState"
        },
        "structures": {
          "$ref": "#/definitions/StructuresEditorState"
        },
        "windowLayout": {
          "$ref": "#/definitions/IJsonRowNode"
        }
      },
      "required": [
        "orgId",
        "deviceClassId",
        "deviceClassVersion",
        "basicData",
        "libraries",
        "deviceLibrary",
        "parameters",
        "structures",
        "resources",
        "commands",
        "dmx",
        "localizations",
        "windowLayout"
      ],
      "type": "object"
    },
    "DeviceClassInfo": {
      "additionalProperties": false,
